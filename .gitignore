# Ignore dataset artifacts and generated data
data/*.csv
data/*.zip
data/*.pkl
data/models_pretrained/
data/data/
__pycache__/
*.pyc
logs/

# Exceptions: small, deliverable files worth tracking despite the blanket
# rules above. Raw source data (csic_database.csv, labeled_csic_database.csv,
